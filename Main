                    std::cout << "Red Team: Good job!\n";
                }
                else if (lf == "r") {
                    std::cout << "You go right and get blocked!\n";
                    std::this_thread::sleep_for(std::chrono::seconds(1));
                    std::cout << "Blue Team: Good block!\n";
                }
            }
        }
        if (lf == "l") {
            RedScore += 2;
        }
		else if (lf == "r") {
			BlueScore += 2;
		}
        std::cout << "They have possession, one of them is infront of you, do you try to steal the ball? (y/n)\n";
        std::this_thread::sleep_for(std::chrono::seconds(1));
        std::string steal;
        std::getline(std::cin, steal);
        if (steal == "y") {
            std::cout << "You steal the ball!\n";
            std::this_thread::sleep_for(std::chrono::seconds(1));
            std::cout << "Red Team: Good job!\n";
        }
        else if (steal == "n") {
            std::cout << "You don't steal the ball and they make a layup!\n";
            std::this_thread::sleep_for(std::chrono::seconds(1));
            std::cout << "Blue Team: Good job!\n";
        }
        else {
            while (steal != "y" && steal != "n") {
                std::cout << "Please respond with y or n\n";
                std::getline(std::cin, steal);
                if (steal == "y") {
                    std::cout << "You steal the ball!\n";
                    std::this_thread::sleep_for(std::chrono::seconds(1));
                    std::cout << "Red Team: Good job!\n";
                }
                else if (steal == "n") {
                    std::cout << "You don't steal the ball and they make a layup!\n";
                    std::this_thread::sleep_for(std::chrono::seconds(1));
                    std::cout << "Blue Team: Good job!\n";
                }
            }
        }
		if (steal == "n") {
			BlueScore += 2;
		}
		else if (steal == "y") {
			RedScore += 2;
		}
        if (steal == "y") {
            std::cout << "You run to the goal!\n";
            std::this_thread::sleep_for(std::chrono::seconds(1));
			std::cout << "You make a layup!\n";
            std::this_thread::sleep_for(std::chrono::seconds(1));
			std::cout << "Red Team: Good job!\n";
    }
       
    }
    std::cout << "The game ends.\n";
    std::this_thread::sleep_for(std::chrono::seconds(1));
    std::cout << "Red Team's score: " << RedScore << "\n";
    std::this_thread::sleep_for(std::chrono::seconds(1));
	std::cout << "Blue Team's score: " << BlueScore << "\n";
    std::this_thread::sleep_for(std::chrono::seconds(1));
    std::string Winner;
    if (RedScore > BlueScore) {
        Winner = "Red Team";
	}
	else if (BlueScore > RedScore) {
		Winner = "Blue Team";
	}
	else {
		Winner = "It's a tie!";
	}
    std::cout << "The Winner is: " << Winner << "\n";
    std::cout << "Class Ends\n";
    std::this_thread::sleep_for(std::chrono::seconds(1));
	std::cout << "Time: 2:30 PM\n";
    std::this_thread::sleep_for(std::chrono::seconds(1));
	std::cout << "You wait in the hallway for 7th period, Art\n";
    std::this_thread::sleep_for(std::chrono::seconds(1));
	std::cout << "Class Starts\n";
    std::this_thread::sleep_for(std::chrono::seconds(1));
	std::cout << "Time: 2:45 PM\n";
	std::cout << "Art Teacher: Today we will learn about the color wheel and how to mix colors.\n";
    std::this_thread::sleep_for(std::chrono::seconds(1));
	std::cout << "Art Teacher: The color wheel is a circular diagram that shows the relationships between colors. It consists of primary colors (red, blue, yellow), secondary colors (green, orange, purple), and tertiary colors (mixes of primary and secondary colors).\n";
    std::this_thread::sleep_for(std::chrono::seconds(1));
	std::cout << "Art Teacher: When mixing colors, primary colors can be combined to create secondary colors. For example, mixing red and blue creates purple, blue and yellow create green, and red and yellow create orange.\n";
    std::this_thread::sleep_for(std::chrono::seconds(1));
    std::cout << "Art Teacher: Tertiary colors are created by mixing a primary color with a secondary color. For example, mixing red with orange creates red-orange, and mixing blue with green creates blue-green.\n";
	std::this_thread::sleep_for(std::chrono::seconds(1));
	std::cout << "Class Ends\n";
	std::this_thread::sleep_for(std::chrono::seconds(1));
	std::cout << "Time: 3:30 PM\n";
    std::cout << "You wait for your bus to go home.\n";
    std::this_thread::sleep_for(std::chrono::seconds(4));
	std::cout << "You get on the bus and see the bullies from this morning.\n";
    std::this_thread::sleep_for(std::chrono::seconds(1));
    if (Winner == "Red Team") {
		std::cout << "Bully 1: We seen you in gym class, you think you're better than us?\n";
        std::this_thread::sleep_for(std::chrono::seconds(1));
		std::cout << "You: No, I just played the game.\n";
        std::this_thread::sleep_for(std::chrono::seconds(1));
        std::cout << "Bully 2: Well we'll see how good you are tommorrow morning, loser!\n";
    }
	if (Winner == "Blue Team") {
		std::cout << "Bully 1: We seen you play basketball in gym class, no wonder you lost, you're trash!\n";
		std::this_thread::sleep_for(std::chrono::seconds(1));
        std::cout << "Bully 2: We're gonna teach you in the morning, idiot\n";
        std::this_thread::sleep_for(std::chrono::seconds(1));
	}
	std::cout << "You get home and your mom asks how your day was.\n";
    std::this_thread::sleep_for(std::chrono::seconds(1));
    std::cout << "Tell her the truth? y/n\n";
    std::this_thread::sleep_for(std::chrono::seconds(1));
    std::string Truth;
	std::getline(std::cin, Truth);
    if (Truth == "y") {
std::cout << "You: These two kids started teasing me.\n";
std::this_thread::sleep_for(std::chrono::seconds(1));
std::cout << "Mom: I'm sorry that happened, I'll try to talk to the school about it.\n";

	}
    else if (Truth == "n") {
        std::cout << "You: It was a good day, mom.\n";
        std::this_thread::sleep_for(std::chrono::seconds(1));
        std::cout << "Mom: I'm glad to hear that, honey.\n";
    }
    std::cout << "Thanks for playing the DEMO!\n Join the Discord: https://discord.gg/YB8Y7WMPb\n";
}
